 222:src/main.cpp  **** /* ---- FastLog stub ---- */
 223:src/main.cpp  **** uint32_t FastLog(uint32_t f) {
 224:src/main.cpp  ****     if (f == 0) return 0;
 225:src/main.cpp  ****     Float_t fl;
 226:src/main.cpp  ****     fl.i = f;
 227:src/main.cpp  ****     uint32_t mantissa = fl.parts.mantissa >> (23 - LOGTSIZEN);
