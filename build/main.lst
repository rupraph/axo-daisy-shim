  90:src/main.cpp  **** void *sdram_malloc(size_t size) {
  91:src/main.cpp  ****     /* Align to 4 bytes */
  92:src/main.cpp  ****     size = (size + 3) & ~3;
  93:src/main.cpp  ****     if (sdram_heap_ptr + size > sdram_heap_end) {
  94:src/main.cpp  ****         return nullptr;
  95:src/main.cpp  ****     }
  96:src/main.cpp  ****     sdram_last_alloc = sdram_heap_ptr;
  97:src/main.cpp  ****     void *ptr = sdram_heap_ptr;
  98:src/main.cpp  ****     sdram_heap_ptr += size;
  99:src/main.cpp  ****     return ptr;
 100:src/main.cpp  **** }
 101:src/main.cpp  **** 
 102:src/main.cpp  **** void sdram_free(void *ptr) {
 103:src/main.cpp  ****     /* Can only free the last allocation (stack allocator) */
 104:src/main.cpp  ****     if (ptr == sdram_last_alloc) {
 105:src/main.cpp  ****         sdram_heap_ptr = sdram_last_alloc;
 106:src/main.cpp  ****         sdram_last_alloc = nullptr;
 107:src/main.cpp  ****     }
 108:src/main.cpp  **** }
 109:src/main.cpp  **** 
