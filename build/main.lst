 227:../libDaisy/src/hid/midi.h ****     /** Feed in bytes to parser state machine from an external source.
 228:../libDaisy/src/hid/midi.h ****         Populates internal FIFO queue with MIDI Messages.
 229:../libDaisy/src/hid/midi.h **** 
 230:../libDaisy/src/hid/midi.h ****         \note  Normally application code won't need to use this method directly.
 231:../libDaisy/src/hid/midi.h ****         \param byte MIDI byte to be parsed
 232:../libDaisy/src/hid/midi.h ****     */
 233:../libDaisy/src/hid/midi.h ****     void Parse(uint8_t byte)
 234:../libDaisy/src/hid/midi.h ****     {
 235:../libDaisy/src/hid/midi.h ****         MidiEvent event;
