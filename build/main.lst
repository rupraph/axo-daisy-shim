 119:src/main.cpp  **** /* ---- Lookup tables ---- */
 120:src/main.cpp  **** 
 121:src/main.cpp  **** /*
 122:src/main.cpp  ****  * These tables are normally defined in axoloti_math.c in the firmware.
 123:src/main.cpp  ****  * We generate them at startup using the same formulas.
 124:src/main.cpp  ****  */
 125:src/main.cpp  **** int32_t sine2t[SINE2TSIZE + 1];
 126:src/main.cpp  **** int16_t windowt[WINDOWSIZE + 1];
 127:src/main.cpp  **** uint32_t pitcht[PITCHTSIZE];
 128:src/main.cpp  **** uint16_t expt[EXPTSIZE];
 129:src/main.cpp  **** uint16_t logt[LOGTSIZE];
 130:src/main.cpp  **** int16_t blept[BLEPSIZE];
 131:src/main.cpp  **** 
 132:src/main.cpp  **** static void generate_lookup_tables(void) {
 133:src/main.cpp  ****   /* Sine table: Q31 sine over one full period */
 134:src/main.cpp  ****   for (int i = 0; i <= SINE2TSIZE; i++) {
 135:src/main.cpp  ****     sine2t[i] = (int32_t)(2147483647.0 * sin(2.0 * 3.14159265358979323846 * i /
 136:src/main.cpp  ****                                              (double)SINE2TSIZE));
 137:src/main.cpp  ****   }
 138:src/main.cpp  **** 
 139:src/main.cpp  ****   /* Hann window table: Q15 */
 140:src/main.cpp  ****   for (int i = 0; i <= WINDOWSIZE; i++) {
 141:src/main.cpp  ****     windowt[i] = (int16_t)(16383.0 *
 142:src/main.cpp  ****                            (1.0 - cos(2.0 * 3.14159265358979323846 * i /
 143:src/main.cpp  ****                                       (double)WINDOWSIZE)) /
 144:src/main.cpp  ****                            2.0);
 145:src/main.cpp  ****   }
 146:src/main.cpp  **** 
 147:src/main.cpp  ****   /* Pitch table: MIDI pitch to frequency (Q31 phase increment for 48kHz)
 148:src/main.cpp  ****    * pitcht[128] = middle C (MIDI 60), covers ±128 semitones around
 149:src/main.cpp  ****    * The table maps semitone index to phase increment:
ARM GAS  /var/folders/y2/46dr13592vnb75z1nplr1hs40000gn/T//ccXIIoon.s 			page 30


 150:src/main.cpp  ****    * freq = 440 * 2^((note-69)/12)
 151:src/main.cpp  ****    * phase_inc = freq / 48000 * 2^32
 152:src/main.cpp  ****    */
 153:src/main.cpp  ****   for (int i = 0; i < PITCHTSIZE; i++) {
 154:src/main.cpp  ****     double note = (double)(i - 128) + 64.0; /* offset so index 128 = MIDI 64 */
 155:src/main.cpp  ****     double freq = 440.0 * pow(2.0, (note - 69.0) / 12.0);
 156:src/main.cpp  ****     double phase_inc = freq / 48000.0 * 4294967296.0;
 157:src/main.cpp  ****     if (phase_inc > 2147483647.0)
 158:src/main.cpp  ****       phase_inc = 2147483647.0;
 159:src/main.cpp  ****     pitcht[i] = (uint32_t)phase_inc;
 160:src/main.cpp  ****   }
 161:src/main.cpp  **** 
 162:src/main.cpp  ****   /* Exponential table: 2^(i/256) scaled to Q16 */
 163:src/main.cpp  ****   for (int i = 0; i < EXPTSIZE; i++) {
 164:src/main.cpp  ****     expt[i] = (uint16_t)(65535.0 * pow(2.0, (double)i / 256.0) / 2.0);
 165:src/main.cpp  ****   }
 166:src/main.cpp  **** 
 167:src/main.cpp  ****   /* Log table: log2 scaled to Q16 */
 168:src/main.cpp  ****   for (int i = 0; i < LOGTSIZE; i++) {
 169:src/main.cpp  ****     double v = (double)(i + 1) / (double)LOGTSIZE;
 170:src/main.cpp  ****     logt[i] = (uint16_t)(65535.0 * (log(v) / log(2.0) + LOGTSIZEN) /
 171:src/main.cpp  ****                          (double)LOGTSIZEN);
 172:src/main.cpp  ****   }
 173:src/main.cpp  **** 
 174:src/main.cpp  ****   /* BLEP table: bandlimited step for anti-aliased oscillators */
 175:src/main.cpp  ****   for (int i = 0; i < BLEPSIZE; i++) {
 176:src/main.cpp  ****     double t = (double)i / (double)BLEPSIZE * 4.0 - 2.0;
 177:src/main.cpp  ****     double sinc_val;
 178:src/main.cpp  ****     if (fabs(t) < 1e-10) {
 179:src/main.cpp  ****       sinc_val = 1.0;
 180:src/main.cpp  ****     } else {
 181:src/main.cpp  ****       sinc_val = sin(3.14159265358979323846 * t) / (3.14159265358979323846 * t);
 182:src/main.cpp  ****     }
 183:src/main.cpp  ****     /* Apply Hann window */
 184:src/main.cpp  ****     double window =
 185:src/main.cpp  ****         0.5 * (1.0 - cos(2.0 * 3.14159265358979323846 * i / (double)BLEPSIZE));
 186:src/main.cpp  ****     /* Integrate and scale to Q15 */
 187:src/main.cpp  ****     blept[i] = (int16_t)(sinc_val * window * 16384.0);
 188:src/main.cpp  ****   }
 189:src/main.cpp  **** }
