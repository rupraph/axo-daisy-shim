  40:src/main.cpp  **** /*
  41:src/main.cpp  ****  * Linker symbols referenced by xpatch_init2().
  42:src/main.cpp  ****  * On real Axoloti, these delimit a dynamic-patch BSS section and
  43:src/main.cpp  ****  * constructor/destructor arrays in SRAM. On Daisy the patch is
  44:src/main.cpp  ****  * statically linked, so BSS is already zeroed by startup code and
  45:src/main.cpp  ****  * constructors run normally.
  46:src/main.cpp  ****  *
  47:src/main.cpp  ****  * We alias every *_end symbol to its *_start counterpart so that:
  48:src/main.cpp  ****  *   &start == &end  →  loop executes zero iterations  →  no memory corruption.
  49:src/main.cpp  ****  *
  50:src/main.cpp  ****  * _sdram_dyn_start / _sdram_dyn_end are plain char variables.
  51:src/main.cpp  ****  * xpatch_init2 calls sdram_init() with their addresses, which temporarily
  52:src/main.cpp  ****  * points the allocator at useless RAM.  We re-init SDRAM after xpatch_init
  53:src/main.cpp  ****  * returns (see main()).
  54:src/main.cpp  ****  */
  55:src/main.cpp  **** extern "C" {
  56:src/main.cpp  ****     typedef void (*funcp_t)(void);
  57:src/main.cpp  **** 
  58:src/main.cpp  ****     /* Patch BSS region — _pbss_end is aliased to _pbss_start via asm below */
  59:src/main.cpp  ****     uint32_t _pbss_start = 0;
  60:src/main.cpp  **** 
  61:src/main.cpp  ****     /* Constructor / destructor arrays — ends aliased to starts via asm below */
  62:src/main.cpp  ****     funcp_t __ctor_array_start = nullptr;
  63:src/main.cpp  ****     funcp_t __dtor_array_start = nullptr;
  64:src/main.cpp  **** 
  65:src/main.cpp  ****     /* SDRAM region markers — dummy variables; see re-init in main() */
  66:src/main.cpp  ****     char _sdram_dyn_start = 0;
  67:src/main.cpp  ****     char _sdram_dyn_end = 0;
  68:src/main.cpp  **** }
  69:src/main.cpp  **** 
  70:src/main.cpp  **** /*
  71:src/main.cpp  ****  * Assembly-level aliases: make every *_end symbol equal its *_start.
  72:src/main.cpp  ****  * This causes the clearing/iteration loops in xpatch_init2 to execute
  73:src/main.cpp  ****  * zero iterations, preventing memory corruption.
  74:src/main.cpp  ****  */
  75:src/main.cpp  **** asm(".global _pbss_end\n .set _pbss_end, _pbss_start");
  76:src/main.cpp  **** asm(".global __ctor_array_end\n .set __ctor_array_end, __ctor_array_start");
  77:src/main.cpp  **** asm(".global __dtor_array_end\n .set __dtor_array_end, __dtor_array_start");
