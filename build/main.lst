 193:../libDaisy/src/hid/midi.h ****     /** Start listening */
 194:../libDaisy/src/hid/midi.h ****     void Listen()
 195:../libDaisy/src/hid/midi.h ****     {
 196:../libDaisy/src/hid/midi.h ****         // In case of UART Error, (particularly
 197:../libDaisy/src/hid/midi.h ****         //  overrun error), UART disables itself.
 198:../libDaisy/src/hid/midi.h ****         // Flush the buff, and restart.
 199:../libDaisy/src/hid/midi.h ****         if(!transport_.RxActive())
 200:../libDaisy/src/hid/midi.h ****         {
 201:../libDaisy/src/hid/midi.h ****             parser_.Reset();
 202:../libDaisy/src/hid/midi.h ****             transport_.FlushRx();
 203:../libDaisy/src/hid/midi.h ****             StartReceive();
 204:../libDaisy/src/hid/midi.h ****         }
 205:../libDaisy/src/hid/midi.h ****     }
 206:../libDaisy/src/hid/midi.h **** 
 207:../libDaisy/src/hid/midi.h ****     /** Checks if there are unhandled messages in the queue
 208:../libDaisy/src/hid/midi.h ****     \return True if there are events to be handled, else false.
 209:../libDaisy/src/hid/midi.h ****      */
 210:../libDaisy/src/hid/midi.h ****     bool HasEvents() const { return event_q_.GetNumElements() > 0; }
 211:../libDaisy/src/hid/midi.h **** 
 212:../libDaisy/src/hid/midi.h ****     bool RxActive() { return transport_.RxActive(); }
 213:../libDaisy/src/hid/midi.h **** 
 214:../libDaisy/src/hid/midi.h ****     /** Pops the oldest unhandled MidiEvent from the internal queue
 215:../libDaisy/src/hid/midi.h ****     \return The event to be handled
 216:../libDaisy/src/hid/midi.h ****      */
 217:../libDaisy/src/hid/midi.h ****     MidiEvent PopEvent() { return event_q_.PopFront(); }
