  79:src/main.cpp  **** /* ---- SDRAM allocator state ---- */
  80:src/main.cpp  **** static char *sdram_heap_ptr = nullptr;
  81:src/main.cpp  **** static char *sdram_heap_end = nullptr;
  82:src/main.cpp  **** static char *sdram_last_alloc = nullptr;
  83:src/main.cpp  **** 
  84:src/main.cpp  **** void sdram_init(char *base_addr, char *end_addr) {
  85:src/main.cpp  ****     sdram_heap_ptr = base_addr;
  86:src/main.cpp  ****     sdram_heap_end = end_addr;
  87:src/main.cpp  ****     sdram_last_alloc = nullptr;
  88:src/main.cpp  **** }
