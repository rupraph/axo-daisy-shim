  99:src/main.cpp  **** /* ---- Lookup tables ---- */
 100:src/main.cpp  **** 
 101:src/main.cpp  **** /*
 102:src/main.cpp  ****  * These tables are normally defined in axoloti_math.c in the firmware.
 103:src/main.cpp  ****  * We generate them at startup using the same formulas.
 104:src/main.cpp  ****  */
 105:src/main.cpp  **** int32_t sine2t[SINE2TSIZE + 1];
 106:src/main.cpp  **** int16_t windowt[WINDOWSIZE + 1];
 107:src/main.cpp  **** uint32_t pitcht[PITCHTSIZE];
 108:src/main.cpp  **** uint16_t expt[EXPTSIZE];
 109:src/main.cpp  **** uint16_t logt[LOGTSIZE];
 110:src/main.cpp  **** int16_t blept[BLEPSIZE];
 111:src/main.cpp  **** 
 112:src/main.cpp  **** static void generate_lookup_tables(void) {
 113:src/main.cpp  ****     /* Sine table: Q31 sine over one full period */
 114:src/main.cpp  ****     for (int i = 0; i <= SINE2TSIZE; i++) {
 115:src/main.cpp  ****         sine2t[i] = (int32_t)(2147483647.0 *
 116:src/main.cpp  ****                                sin(2.0 * 3.14159265358979323846 * i /
 117:src/main.cpp  ****                                    (double)SINE2TSIZE));
 118:src/main.cpp  ****     }
 119:src/main.cpp  **** 
 120:src/main.cpp  ****     /* Hann window table: Q15 */
 121:src/main.cpp  ****     for (int i = 0; i <= WINDOWSIZE; i++) {
 122:src/main.cpp  ****         windowt[i] = (int16_t)(16383.0 *
 123:src/main.cpp  ****                                 (1.0 - cos(2.0 * 3.14159265358979323846 * i /
 124:src/main.cpp  ****                                            (double)WINDOWSIZE)) /
 125:src/main.cpp  ****                                 2.0);
 126:src/main.cpp  ****     }
 127:src/main.cpp  **** 
 128:src/main.cpp  ****     /* Pitch table: MIDI pitch to frequency (Q31 phase increment for 48kHz)
 129:src/main.cpp  ****      * pitcht[128] = middle C (MIDI 60), covers ±128 semitones around
 130:src/main.cpp  ****      * The table maps semitone index to phase increment:
 131:src/main.cpp  ****      * freq = 440 * 2^((note-69)/12)
 132:src/main.cpp  ****      * phase_inc = freq / 48000 * 2^32
 133:src/main.cpp  ****      */
 134:src/main.cpp  ****     for (int i = 0; i < PITCHTSIZE; i++) {
 135:src/main.cpp  ****         double note = (double)(i - 128) + 64.0; /* offset so index 128 = MIDI 64 */
 136:src/main.cpp  ****         double freq = 440.0 * pow(2.0, (note - 69.0) / 12.0);
 137:src/main.cpp  ****         double phase_inc = freq / 48000.0 * 4294967296.0;
 138:src/main.cpp  ****         if (phase_inc > 2147483647.0)
 139:src/main.cpp  ****             phase_inc = 2147483647.0;
 140:src/main.cpp  ****         pitcht[i] = (uint32_t)phase_inc;
 141:src/main.cpp  ****     }
 142:src/main.cpp  **** 
 143:src/main.cpp  ****     /* Exponential table: 2^(i/256) scaled to Q16 */
ARM GAS  /var/folders/y2/46dr13592vnb75z1nplr1hs40000gn/T//ccyIEqPV.s 			page 27


 144:src/main.cpp  ****     for (int i = 0; i < EXPTSIZE; i++) {
 145:src/main.cpp  ****         expt[i] = (uint16_t)(65535.0 * pow(2.0, (double)i / 256.0) / 2.0);
 146:src/main.cpp  ****     }
 147:src/main.cpp  **** 
 148:src/main.cpp  ****     /* Log table: log2 scaled to Q16 */
 149:src/main.cpp  ****     for (int i = 0; i < LOGTSIZE; i++) {
 150:src/main.cpp  ****         double v = (double)(i + 1) / (double)LOGTSIZE;
 151:src/main.cpp  ****         logt[i] = (uint16_t)(65535.0 * (log(v) / log(2.0) + LOGTSIZEN) /
 152:src/main.cpp  ****                               (double)LOGTSIZEN);
 153:src/main.cpp  ****     }
 154:src/main.cpp  **** 
 155:src/main.cpp  ****     /* BLEP table: bandlimited step for anti-aliased oscillators */
 156:src/main.cpp  ****     for (int i = 0; i < BLEPSIZE; i++) {
 157:src/main.cpp  ****         double t = (double)i / (double)BLEPSIZE * 4.0 - 2.0;
 158:src/main.cpp  ****         double sinc_val;
 159:src/main.cpp  ****         if (fabs(t) < 1e-10) {
 160:src/main.cpp  ****             sinc_val = 1.0;
 161:src/main.cpp  ****         } else {
 162:src/main.cpp  ****             sinc_val =
 163:src/main.cpp  ****                 sin(3.14159265358979323846 * t) / (3.14159265358979323846 * t);
 164:src/main.cpp  ****         }
 165:src/main.cpp  ****         /* Apply Hann window */
 166:src/main.cpp  ****         double window =
 167:src/main.cpp  ****             0.5 * (1.0 - cos(2.0 * 3.14159265358979323846 * i / (double)BLEPSIZE));
 168:src/main.cpp  ****         /* Integrate and scale to Q15 */
 169:src/main.cpp  ****         blept[i] = (int16_t)(sinc_val * window * 16384.0);
 170:src/main.cpp  ****     }
 171:src/main.cpp  **** }
