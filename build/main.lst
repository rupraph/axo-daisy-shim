  95:src/main.cpp  **** void *sdram_malloc(size_t size) {
  96:src/main.cpp  ****   /* Align to 4 bytes */
  97:src/main.cpp  ****   size = (size + 3) & ~3;
  98:src/main.cpp  ****   if (sdram_heap_ptr + size > sdram_heap_end) {
  99:src/main.cpp  ****     return nullptr;
 100:src/main.cpp  ****   }
 101:src/main.cpp  ****   sdram_last_alloc = sdram_heap_ptr;
 102:src/main.cpp  ****   void *ptr = sdram_heap_ptr;
 103:src/main.cpp  ****   sdram_heap_ptr += size;
 104:src/main.cpp  ****   return ptr;
 105:src/main.cpp  **** }
 106:src/main.cpp  **** 
 107:src/main.cpp  **** void sdram_free(void *ptr) {
 108:src/main.cpp  ****   /* Can only free the last allocation (stack allocator) */
 109:src/main.cpp  ****   if (ptr == sdram_last_alloc) {
 110:src/main.cpp  ****     sdram_heap_ptr = sdram_last_alloc;
 111:src/main.cpp  ****     sdram_last_alloc = nullptr;
 112:src/main.cpp  ****   }
 113:src/main.cpp  **** }
 114:src/main.cpp  **** 
 115:src/main.cpp  **** int32_t sdram_get_free(void) {
 116:src/main.cpp  ****   return (int32_t)(sdram_heap_end - sdram_heap_ptr);
 117:src/main.cpp  **** }
