  87:src/main.cpp  **** static char *sdram_last_alloc = nullptr;
  88:src/main.cpp  **** 
  89:src/main.cpp  **** void sdram_init(char *base_addr, char *end_addr) {
  90:src/main.cpp  ****   sdram_heap_ptr = base_addr;
  91:src/main.cpp  ****   sdram_heap_end = end_addr;
  92:src/main.cpp  ****   sdram_last_alloc = nullptr;
