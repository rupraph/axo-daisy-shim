  43:src/main.cpp  **** /*
  44:src/main.cpp  ****  * Linker symbols referenced by xpatch_init2().
  45:src/main.cpp  ****  * On real Axoloti, these delimit a dynamic-patch BSS section and
  46:src/main.cpp  ****  * constructor/destructor arrays in SRAM. On Daisy the patch is
  47:src/main.cpp  ****  * statically linked, so BSS is already zeroed by startup code and
  48:src/main.cpp  ****  * constructors run normally.
  49:src/main.cpp  ****  *
  50:src/main.cpp  ****  * We alias every *_end symbol to its *_start counterpart so that:
  51:src/main.cpp  ****  *   &start == &end  →  loop executes zero iterations  →  no memory corruption.
  52:src/main.cpp  ****  *
  53:src/main.cpp  ****  * _sdram_dyn_start / _sdram_dyn_end are plain char variables.
  54:src/main.cpp  ****  * xpatch_init2 calls sdram_init() with their addresses, which temporarily
  55:src/main.cpp  ****  * points the allocator at useless RAM.  We re-init SDRAM after xpatch_init
  56:src/main.cpp  ****  * returns (see main()).
  57:src/main.cpp  ****  */
  58:src/main.cpp  **** extern "C" {
  59:src/main.cpp  ****     typedef void (*funcp_t)(void);
  60:src/main.cpp  **** 
  61:src/main.cpp  ****     /* Patch BSS region — _pbss_end is aliased to _pbss_start via asm below */
  62:src/main.cpp  ****     uint32_t _pbss_start = 0;
  63:src/main.cpp  **** 
  64:src/main.cpp  ****     /* Constructor / destructor arrays — ends aliased to starts via asm below */
  65:src/main.cpp  ****     funcp_t __ctor_array_start = nullptr;
  66:src/main.cpp  ****     funcp_t __dtor_array_start = nullptr;
  67:src/main.cpp  **** 
  68:src/main.cpp  ****     /* SDRAM region markers — dummy variables; see re-init in main() */
  69:src/main.cpp  ****     char _sdram_dyn_start = 0;
  70:src/main.cpp  ****     char _sdram_dyn_end = 0;
  71:src/main.cpp  **** }
  72:src/main.cpp  **** 
  73:src/main.cpp  **** /*
  74:src/main.cpp  ****  * Assembly-level aliases: make every *_end symbol equal its *_start.
  75:src/main.cpp  ****  * This causes the clearing/iteration loops in xpatch_init2 to execute
  76:src/main.cpp  ****  * zero iterations, preventing memory corruption.
  77:src/main.cpp  ****  */
ARM GAS  /var/folders/y2/46dr13592vnb75z1nplr1hs40000gn/T//ccia2gz5.s 			page 26


  78:src/main.cpp  **** asm(".global _pbss_end\n .set _pbss_end, _pbss_start");
  79:src/main.cpp  **** asm(".global __ctor_array_end\n .set __ctor_array_end, __ctor_array_start");
  80:src/main.cpp  **** asm(".global __dtor_array_end\n .set __dtor_array_end, __dtor_array_start");
  81:src/main.cpp  **** 
  82:src/main.cpp  **** /* ---- SDRAM allocator state ---- */
  83:src/main.cpp  **** static char *sdram_heap_ptr = nullptr;
  84:src/main.cpp  **** static char *sdram_heap_end = nullptr;
  85:src/main.cpp  **** static char *sdram_last_alloc = nullptr;
  86:src/main.cpp  **** 
  87:src/main.cpp  **** void sdram_init(char *base_addr, char *end_addr) {
  88:src/main.cpp  ****     sdram_heap_ptr = base_addr;
  89:src/main.cpp  ****     sdram_heap_end = end_addr;
  90:src/main.cpp  ****     sdram_last_alloc = nullptr;
  91:src/main.cpp  **** }
  92:src/main.cpp  **** 
  93:src/main.cpp  **** void *sdram_malloc(size_t size) {
  94:src/main.cpp  ****     /* Align to 4 bytes */
  95:src/main.cpp  ****     size = (size + 3) & ~3;
  96:src/main.cpp  ****     if (sdram_heap_ptr + size > sdram_heap_end) {
  97:src/main.cpp  ****         return nullptr;
  98:src/main.cpp  ****     }
  99:src/main.cpp  ****     sdram_last_alloc = sdram_heap_ptr;
 100:src/main.cpp  ****     void *ptr = sdram_heap_ptr;
 101:src/main.cpp  ****     sdram_heap_ptr += size;
 102:src/main.cpp  ****     return ptr;
 103:src/main.cpp  **** }
 104:src/main.cpp  **** 
 105:src/main.cpp  **** void sdram_free(void *ptr) {
 106:src/main.cpp  ****     /* Can only free the last allocation (stack allocator) */
 107:src/main.cpp  ****     if (ptr == sdram_last_alloc) {
 108:src/main.cpp  ****         sdram_heap_ptr = sdram_last_alloc;
 109:src/main.cpp  ****         sdram_last_alloc = nullptr;
 110:src/main.cpp  ****     }
 111:src/main.cpp  **** }
 112:src/main.cpp  **** 
 113:src/main.cpp  **** int32_t sdram_get_free(void) {
 114:src/main.cpp  ****     return (int32_t)(sdram_heap_end - sdram_heap_ptr);
 115:src/main.cpp  **** }
