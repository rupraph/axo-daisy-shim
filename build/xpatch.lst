  33:./src/axoloti_filters.h ****                   int32_t *destbuf, uint32_t filter_W0, uint32_t q_inv) {
  34:./src/axoloti_filters.h ****   int32_t sinW0;
  35:./src/axoloti_filters.h ****   int32_t cosW0;
  36:./src/axoloti_filters.h ****   int a = filter_W0;
  37:./src/axoloti_filters.h ****   int b = filter_W0 + (1 << 30);
  38:./src/axoloti_filters.h ****   SINE2TINTERP(a, sinW0)
  39:./src/axoloti_filters.h ****   SINE2TINTERP(b, cosW0)
  40:./src/axoloti_filters.h ****   int32_t alpha = ___SMMUL(sinW0, q_inv);
  41:./src/axoloti_filters.h ****   int32_t filter_x_n1 = v->filter_x_n1;
  42:./src/axoloti_filters.h ****   int32_t filter_x_n2 = v->filter_x_n2;
  43:./src/axoloti_filters.h ****   int32_t filter_y_n1 = v->filter_y_n1;
  44:./src/axoloti_filters.h ****   int32_t filter_y_n2 = v->filter_y_n2;
  45:./src/axoloti_filters.h ****   float filter_a0 = (HALFQ31 + alpha);
  46:./src/axoloti_filters.h ****   float filter_a0_inv = ((INT32_MAX >> 2) / filter_a0);
  47:./src/axoloti_filters.h ****   int32_t a0_inv_q31 = (int32_t)(INT32_MAX * filter_a0_inv);
  48:./src/axoloti_filters.h ****   int32_t filter_a1 = ___SMMUL(-(-cosW0), a0_inv_q31);
  49:./src/axoloti_filters.h ****   int32_t filter_a2 = ___SMMUL(-(HALFQ31 - alpha), a0_inv_q31);
  50:./src/axoloti_filters.h ****   int32_t filter_b0 = ___SMMUL(HALFQ31 - (cosW0 >> 1), a0_inv_q31);
  51:./src/axoloti_filters.h ****   int32_t filter_b1 = (filter_b0 >> 1);
  52:./src/axoloti_filters.h ****   int i;
  53:./src/axoloti_filters.h ****   for (i = 0; i < BUFSIZE; i++) {
  54:./src/axoloti_filters.h ****     int32_t filterinput = *(sourcebuf++);
  55:./src/axoloti_filters.h ****     int32_t accu = ___SMMUL(filter_b0, filterinput);
  56:./src/axoloti_filters.h ****     accu = ___SMMLA(filter_b0, filter_x_n2, accu);
  57:./src/axoloti_filters.h ****     accu = ___SMMLA(filter_b1, filter_x_n1, accu);
  58:./src/axoloti_filters.h ****     accu = ___SMMLA(filter_a1, filter_y_n1, accu);
  59:./src/axoloti_filters.h ****     accu = ___SMMLA(filter_a2, filter_y_n2, accu);
  60:./src/axoloti_filters.h ****     int32_t filteroutput;
  61:./src/axoloti_filters.h ****     filteroutput = __SSAT(accu, 28) << 4;
  62:./src/axoloti_filters.h ****     filter_x_n2 = filter_x_n1;
  63:./src/axoloti_filters.h ****     filter_x_n1 = filterinput;
  64:./src/axoloti_filters.h ****     filter_y_n2 = filter_y_n1;
  65:./src/axoloti_filters.h ****     filter_y_n1 = filteroutput;
  66:./src/axoloti_filters.h ****     *(destbuf++) = filteroutput;
  67:./src/axoloti_filters.h ****   }
  68:./src/axoloti_filters.h ****   v->filter_x_n1 = filter_x_n1;
