 128:./src/axoloti_math.h **** __attribute__((always_inline)) __STATIC_INLINE uint32_t mtof48k_q31(int32_t pitch) {
 129:./src/axoloti_math.h ****     int32_t p = __SSAT(pitch, 28);
 130:./src/axoloti_math.h ****     uint32_t pi = p >> 21;
 131:./src/axoloti_math.h ****     int32_t y1 = pitcht[128 + pi];
 132:./src/axoloti_math.h ****     int32_t y2 = pitcht[128 + 1 + pi];
 133:./src/axoloti_math.h ****     int32_t pf = (p & 0x1FFFFF) << 10;
 134:./src/axoloti_math.h ****     int32_t pfc = INT32_MAX - pf;
 135:./src/axoloti_math.h ****     uint32_t r;
 136:./src/axoloti_math.h ****     r = ___SMMUL(y1, pfc);
 137:./src/axoloti_math.h ****     r = ___SMMLA(y2, pf, r);
 138:./src/axoloti_math.h ****     return r << 1;
 139:./src/axoloti_math.h **** }
