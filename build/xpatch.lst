 294:xpatch.cpp    ****        case A_BALANCED:
 295:xpatch.cpp    ****              AudioInputLeft[i] = (AudioInputLeft[i] - (inbuf[i*2+1]>>4) ) >> 1;
 296:xpatch.cpp    ****              AudioInputRight[i] = AudioInputLeft[i];             break;
 297:xpatch.cpp    ****        case A_STEREO:
